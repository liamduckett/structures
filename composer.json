{
    "name": "liamduckett/structures",
    "version": "0.0.1",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Liamduckett\\Structures\\": "lib/"
        },
        "files": [
            "lib/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Liam Duckett",
            "email": "liamduckett2@gmail.com"
        }
    ],
    "require": {
        "php": "8.0 - 8.5"
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=2G",
        "lint": "php-cs-fixer fix",
        "lint:check": "php-cs-fixer check",
        "test": "phpunit --fail-on-warning --fail-on-risky",
        "check": [
            "@analyse",
            "@lint:check",
            "@test"
        ]
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpstan/phpstan-strict-rules": "^2",
        "phpunit/phpunit": "^9"
    }
}
